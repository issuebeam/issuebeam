# Copy to .env and fill in ( .env is gitignored )

# GitHub repository slug (owner/name)
GITHUB_REPO=issuebeam/issuebeam

# Personal Access Token — Issues read & write
# Prefer Windows user env var GITHUB_TOKEN instead of committing here
GITHUB_TOKEN=github_pat_xxxxxxxx

# Optional — agent-driven feedback intake (see evolutive/agent_driven_feedback.md)
# URL già default nel CLI; override solo per staging/self-host:
# ISSUEBEAM_INTAKE_API_BASE=https://issuebeam.antoniotrento.net
#
# Token app: NON qui per utenti normali — va in scripts/agent_feedback.py
# (_OFFICIAL_INTAKE_APP_TOKEN). Questa env serve solo a te per override locale:
# ISSUEBEAM_APP_TOKEN=
